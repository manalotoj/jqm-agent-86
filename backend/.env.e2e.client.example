# Copy this file to backend/.env.e2e.client and replace every placeholder value.
# These values are read by pytest only. They are intentionally separate from
# backend/.env.e2e, which is loaded by common/scripts/start_local.zsh when
# AGENT86_ENV_MODE=e2e.

E2E_API_BASE_URL=http://127.0.0.1:8000
E2E_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
E2E_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
E2E_ENTRA_CLIENT_SECRET=replace-with-real-client-secret
E2E_ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
